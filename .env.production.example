#==============================================================================
# PRODUCTION .env — Hostinger (single website plan, no SSH)
#
# Fill in the marked values, then upload this as ".env" in the project root
# using Hostinger's File Manager. Do NOT upload your local .env: APP_ENV,
# APP_DEBUG, APP_URL and the database settings all differ.
#
# Nothing here needs a shell. There is no queue worker and no WebSocket server.
#==============================================================================

APP_NAME="ADT Sports"
APP_ENV=production
APP_DEBUG=false

# Paste the APP_KEY from your local .env verbatim. It decrypts existing
# sessions and cookies — a different key logs everyone out.
APP_KEY=

# Your real domain, with https. This is used for signed links in emails.
APP_URL=https://your-domain.com

#-- Database (from hPanel -> Databases -> MySQL) -------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

#-- Drivers -------------------------------------------------------------------
# "database" avoids needing Redis, which shared hosting does not provide.
# If the admin panel ever feels sluggish, switching SESSION_DRIVER to "file"
# removes a database write from every single request.
SESSION_DRIVER=database
SESSION_LIFETIME=120
CACHE_DRIVER=database
QUEUE_CONNECTION=database

#-- Live match screens --------------------------------------------------------
# Leave this as "null" on Hostinger. The scoreboard, timer, main screen and
# live overlay all stay in sync over HTTP, refreshing about once a second.
# Nothing has to be kept running.
#
# For instant (~50ms) updates, create a free app at https://pusher.com
# (Channels), set this to "pusher" and fill in the four keys below. Pusher
# still needs no background process — your server only makes outbound HTTPS
# calls and the browsers connect to Pusher directly.
BROADCAST_CONNECTION=null

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=ap2

#-- Full-page cache for public pages -----------------------------------------
# Admin pages and the live score endpoint are never cached (the profile skips
# authenticated requests and every /admin route), so this is safe to leave on.
RESPONSE_CACHE_ENABLED=true
RESPONSE_CACHE_LIFETIME=600

#-- Mail (optional: subscriber confirmations and password resets) -------------
MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@your-domain.com"
MAIL_FROM_NAME="ADT Sports"
# RESEND_KEY=

#-- Error reporting (optional) ------------------------------------------------
# SENTRY_LARAVEL_DSN=

#-- Reverse proxy -------------------------------------------------------------
# Hostinger terminates TLS in front of PHP. Trusting the proxy is what makes
# $request->secure() true, so secure cookies and https URLs work correctly.
TRUSTED_PROXIES=*
